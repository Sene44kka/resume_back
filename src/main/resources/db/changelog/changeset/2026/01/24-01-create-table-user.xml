<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="001-create-user-table" author="ASkripov">

        <createTable tableName="user" schemaName="public">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="Идентификатор">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_user"/>
            </column>

            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="true"/>
            </column>

            <column name="login" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_user_login"/>
            </column>

            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="middle_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>

            <column name="email" type="VARCHAR(255)">
                <constraints nullable="true" unique="true"/>
            </column>

            <column name="date_of_birth" type="DATE">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createIndex indexName="idx_user_login" tableName="user" schemaName="public" unique="true">
            <column name="login"/>
        </createIndex>

        <createIndex indexName="idx_user_email" tableName="user" schemaName="public" unique="true">
            <column name="email"/>
        </createIndex>

        <createIndex indexName="idx_user_last_name" tableName="user" schemaName="public">
            <column name="last_name"/>
        </createIndex>

        <createIndex indexName="idx_user_created_at" tableName="user" schemaName="public">
            <column name="created_at"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>